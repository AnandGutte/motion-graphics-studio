{
  "name": "science-video-lab",
  "version": "1.0.0",
  "description": "Fully local, disposable animated video lab using Remotion, React, TypeScript, and FFmpeg",
  "private": true,
  "scripts": {
    "build": "remotion render src/index.ts SunAnimation output/sun-animation.mp4",
    "preview": "remotion preview src/index.ts",
    "probe": "./tools/bin/ffprobe -v error -show_format -show_streams output/sun-animation.mp4"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.542"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.542",
    "@types/react": "^18.2.0",
    "typescript": "^5.3.3"
  }
}
